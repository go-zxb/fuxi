package router

import (
	"github.com/gin-gonic/gin"
	"github.com/casbin/casbin/v2"
	api "{{.ModuleName}}/internal/api/{{.FilePath}}"
	repo "{{.ModuleName}}/internal/repo/{{.FilePath}}"
	service "{{.ModuleName}}/internal/service/{{.FilePath}}"
	"{{.ModuleName}}/middleware"
)

type {{.StructName}}ApiInterface interface {
	GetSelfInfo(ctx *gin.Context)
	Login(ctx *gin.Context)
	Register(ctx *gin.Context)
	GetUserList(ctx *gin.Context)
  EditUserInfo(ctx *gin.Context)
  DeleteUser(ctx *gin.Context)
}

type {{.StructName}}Router struct {
	engine *gin.RouterGroup
	api    {{.StructName}}ApiInterface
	enforcer *casbin.CachedEnforcer
}

func New{{.StructName}}Router(engine *gin.RouterGroup,enforcer *casbin.CachedEnforcer) *{{.StructName}}Router {
	return &{{.StructName}}Router{
		engine: engine,
		enforcer: enforcer,
		api:    api.New{{.StructName}}Api(service.New{{.StructName}}Service(repo.New{{.StructName}}Repo())),
	}
}

// Init{{.StructName}}Router 初始化{{.StructName}}路由
func (r *{{.StructName}}Router) Init{{.StructName}}Router() {
	{
		groupV1 := r.engine.Group("sys")
    authGroupV1 := r.engine.Group("sys").Use(middleware.JwtAuth())
    groupV1.POST("users/login", r.api.Login)
    authGroupV1.GET("users/info", r.api.GetSelfInfo)
    groupV1.POST("users/register", r.api.Register)
		groupV1.GET("users/list", r.api.GetUserList)
		groupV1.PUT("users/editUserInfo", r.api.EditUserInfo)
		groupV1.DELETE("users/deleteUser", r.api.DeleteUser)
	}
}
