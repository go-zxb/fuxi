type IApiRepo interface {
	CreateApi(api *apiModel.Api) error
	GetApiList(req *apiModel.ApiReq) ([]*apiModel.Api, error)
	GetAllApi() ([]*apiModel.Api, error)
	UpdateApi(api *apiModel.Api) error
	DeleteApiByIds(ids []uint) error
	DeleteApiById(id uint) error
	AuthApiList(role string) (list []*casbinModel.Casbin, err error)
}

type ApiService struct {
	repo IApiRepo
	rdb  *data.Redis
	conf *config.Config
	log  *zap.SugaredLogger
}

func NewApiService(repo IApiRepo) *ApiService {
	api :=  &ApiService{
  		repo: repo,
  		rdb:  data.GetRedis(),
  		conf: config.GetConfig(),
  		log:  logx.InitLogger(),
  	}
  	err := api.InitApi()
  	if err != nil {
  		panic(err)
  	}
  	return api
}

